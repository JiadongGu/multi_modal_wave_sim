{
  // The extension's python package lives under exts/mmws.wave_sim, which Kit
  // puts on sys.path at runtime. Telling the language server the same thing
  // stops "mmws.wave_sim could not be resolved" on every import.
  "python.analysis.extraPaths": ["exts/mmws.wave_sim"],
  "python.analysis.typeCheckingMode": "basic",
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": false,
  "files.exclude": {
    "**/__pycache__": true
  },
  "[python]": {
    "editor.rulers": [88],
    "editor.tabSize": 4
  }
}
